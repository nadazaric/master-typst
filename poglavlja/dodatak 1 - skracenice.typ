// Овде пишете скраћенице које сте користили у тексту

#import "../funkcije.typ": dodatak

// Због аутоматског бројања сваки додатак мора имати лабелу са префиксом
// dodatak- као у наслову испод.
= Списак коришћених скраћеница <dodatak-1>

#dodatak(
  table(
    table.header[*Скраћеница*][*Опис*],

    [AC],
    [Alternating Current (пулсатилна компонента PPG сигнала)],
    [API],
    [Application Programming Interface (апликациони програмски интерфејс)],
    [BPM],
    [Beats Per Minute (откуцаји у минути)],
    [DC],
    [Direct Current (непулсатилна компонента PPG сигнала)],
    [HRV],
    [Heart Rate Variability (варијабилност срчане фреквенције)],
    [HRVB],
    [Heart Rate Variability Biofeedback (биофидбек заснован на варијабилности срчане фреквенције)],
    [LED],
    [Light-Emitting Diode (свјетлећа диода)],
    [PPG],
    [Photoplethysmography (фотоплетизмографија)],
    [PPI],
    [Pulse-to-Pulse Interval (интервал између узастопних пулсева)],
    [PR],
    [Pulse Rate (фреквенција пулса)],
    [PRV],
    [Pulse Rate Variability (варијабилност фреквенције пулса)],
    [RMSSD],
    [Root Mean Square of Successive Differences (квадратни коријен средње вриједности квадрата
      разлика узастопних интервала)],
    [RSA],
    [Respiratory Sinus Arrhythmia (респираторна синусна аритмија)],
    [SDK],
    [Software Development Kit (развојни пакет)],
    [SDNN],
    [Standard Deviation of Normal-to-Normal Intervals (стандардна девијација нормалних интервала)],
    [SpO₂],
    [засићеност артеријске крви кисеоником],
    [SQI],
    [Signal Quality Index (показатељ квалитета сигнала)],
    [XLSX],
    [формат датотеке за табеларне податке],
  ),
)
